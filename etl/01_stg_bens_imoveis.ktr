<?xml version="1.0" encoding="UTF-8"?>
<transformation>
<info><name>01_stg_bens_imoveis</name><description>Landing (CSV) -&gt; staging</description><extended_description/><trans_version/><trans_type>Normal</trans_type><directory>/</directory>
<parameters><parameter><name>PG_HOST</name><default_value>localhost</default_value><description>Host do PostgreSQL</description></parameter><parameter><name>PG_PORT</name><default_value>5437</default_value><description>Porta do PostgreSQL</description></parameter><parameter><name>PG_DB</name><default_value>dw_bens_imoveis</default_value><description>Banco</description></parameter><parameter><name>PG_USER</name><default_value>postgres</default_value><description>Usuário</description></parameter><parameter><name>PG_PASSWORD</name><default_value></default_value><description>Senha (vem do .env, nunca gravada no arquivo)</description></parameter></parameters>
<size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full>
<unique_connections>N</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size>
<using_thread_priorities>Y</using_thread_priorities><shared_objects_file/><capture_step_performance>N</capture_step_performance>
<step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
<dependencies></dependencies><partitionschemas></partitionschemas><slaveservers></slaveservers><clusterschemas></clusterschemas>
<created_user>-</created_user><modified_user>-</modified_user><key_for_session_key/><is_key_private>N</is_key_private></info>
<notepads><notepad><note>STAGING: lê o CSV gerado por ingestion/reparar_json.py, padroniza os textos (trim, caixa alta, espaços duplicados) e grava em stg.bens_imoveis. Sem regra de negócio: 1 linha por registro da fonte (imóvel x exercício).</note><xloc>64</xloc><yloc>32</yloc><width>760</width><heigth>60</heigth>
<fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
<fontcolorred>14</fontcolorred><fontcolorgreen>58</fontcolorgreen><fontcolorblue>90</fontcolorblue>
<backgroundcolorred>255</backgroundcolorred><backgroundcolorgreen>244</backgroundcolorgreen><backgroundcolorblue>205</backgroundcolorblue>
<bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
<drawshadow>Y</drawshadow></notepad></notepads>
<connection><name>dw_bens_imoveis</name><server>${PG_HOST}</server><type>POSTGRESQL</type><access>Native</access>
<database>${PG_DB}</database><port>${PG_PORT}</port><username>${PG_USER}</username><password>${PG_PASSWORD}</password>
<servername/><data_tablespace/><index_tablespace/><attributes>
<attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
<attribute><code>PORT_NUMBER</code><attribute>${PG_PORT}</attribute></attribute>
<attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
<attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
</attributes></connection>
<order><hop><from>Ler CSV (landing)</from><to>Trim e caixa alta</to><enabled>Y</enabled></hop><hop><from>Trim e caixa alta</from><to>Remover espacos duplicados</to><enabled>Y</enabled></hop><hop><from>Remover espacos duplicados</from><to>Renomear para snake_case</to><enabled>Y</enabled></hop><hop><from>Renomear para snake_case</from><to>stg.bens_imoveis</to><enabled>Y</enabled></hop></order>
<step><name>Ler CSV (landing)</name><type>CsvInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
<partitioning><method>none</method><schema_name/></partitioning>
<filename>${Internal.Entry.Current.Directory}/../data/processed/imoveis.csv</filename><filename_field/><rownum_field/><include_filename>N</include_filename>
<separator>;</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size><lazy_conversion>N</lazy_conversion>
<add_filename_result>N</add_filename_result><parallel>N</parallel><newline_possible>N</newline_possible><format>mixed</format><encoding>UTF-8</encoding>
<fields><field><name>NumeroPatrimonio</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>Exercicio</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>Endereco</name><type>String</type><format></format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>Municipio</name><type>String</type><format></format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>OrgaoGestor</name><type>String</type><format></format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>Destino</name><type>String</type><format></format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>Valor</name><type>Number</type><format>#.##</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>Dimensoes</name><type>Number</type><format>#.##</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field></fields>
<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps>
<GUI><xloc>64</xloc><yloc>160</yloc><draw>Y</draw></GUI></step><step><name>Trim e caixa alta</name><type>StringOperations</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
<partitioning><method>none</method><schema_name/></partitioning>
<fields><field><in_stream_name>Endereco</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>N</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field><field><in_stream_name>Municipio</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>upper</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>N</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field><field><in_stream_name>OrgaoGestor</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>upper</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>N</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field><field><in_stream_name>Destino</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>N</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field></fields>
