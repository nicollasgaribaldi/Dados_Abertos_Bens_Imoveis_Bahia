<partitioning><method>none</method><schema_name/></partitioning>
<fields><field><in_stream_name>Endereco</in_stream_name><out_stream_name/><use_regex>yes</use_regex><replace_string>^[\s,]+</replace_string><replace_by_string/><set_empty_string>Y</set_empty_string><replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>Endereco</in_stream_name><out_stream_name/><use_regex>yes</use_regex><replace_string>[\s,]+$</replace_string><replace_by_string/><set_empty_string>Y</set_empty_string><replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>Endereco</in_stream_name><out_stream_name/><use_regex>yes</use_regex><replace_string>\s+(?=\s)</replace_string><replace_by_string/><set_empty_string>Y</set_empty_string><replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>Endereco</in_stream_name><out_stream_name/><use_regex>yes</use_regex><replace_string>\s+(?=,)</replace_string><replace_by_string/><set_empty_string>Y</set_empty_string><replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>Municipio</in_stream_name><out_stream_name/><use_regex>yes</use_regex><replace_string>\s+(?=\s)</replace_string><replace_by_string/><set_empty_string>Y</set_empty_string><replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field><field><in_stream_name>OrgaoGestor</in_stream_name><out_stream_name/><use_regex>yes</use_regex><replace_string>\s+(?=\s)</replace_string><replace_by_string/><set_empty_string>Y</set_empty_string><replace_field_by_string/><whole_word>no</whole_word><case_sensitive>no</case_sensitive><is_unicode>no</is_unicode></field></fields>
