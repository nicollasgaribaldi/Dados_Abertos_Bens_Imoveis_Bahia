<parameters><parameter><name>PG_HOST</name><default_value>localhost</default_value><description>Host do PostgreSQL</description></parameter><parameter><name>PG_PORT</name><default_value>5437</default_value><description>Porta do PostgreSQL</description></parameter><parameter><name>PG_DB</name><default_value>dw_bens_imoveis</default_value><description>Banco</description></parameter><parameter><name>PG_USER</name><default_value>postgres</default_value><description>Usuário</description></parameter><parameter><name>PG_PASSWORD</name><default_value></default_value><description>Senha (vem do .env, nunca gravada no arquivo)</description></parameter></parameters>
<connection><name>dw_bens_imoveis</name><server>${PG_HOST}</server><type>POSTGRESQL</type><access>Native</access>
