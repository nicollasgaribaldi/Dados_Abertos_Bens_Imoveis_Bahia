<GUI><xloc>864</xloc><yloc>256</yloc><draw>Y</draw></GUI></step><step><name>Flags de qualidade</name><type>Formula</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
<partitioning><method>none</method><schema_name/></partitioning>
<formula><field_name>fl_valor_invalido</field_name><formula_string>IF(ISBLANK([valor]);TRUE();[valor]&lt;=0)</formula_string><value_type>Boolean</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula><formula><field_name>fl_area_invalida</field_name><formula_string>IF(ISBLANK([area_m2]);TRUE();[area_m2]&lt;=0)</formula_string><value_type>Boolean</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula>
<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps>
<GUI><xloc>1024</xloc><yloc>256</yloc><draw>Y</draw></GUI></step><step><name>Colunas da fato</name><type>SelectValues</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
<partitioning><method>none</method><schema_name/></partitioning>
<fields><field><name>sk_imovel</name><rename></rename><length>-2</length><precision>-2</precision></field><field><name>sk_tempo</name><rename></rename><length>-2</length><precision>-2</precision></field><field><name>sk_municipio</name><rename></rename><length>-2</length><precision>-2</precision></field><field><name>sk_orgao</name><rename></rename><length>-2</length><precision>-2</precision></field><field><name>sk_destino</name><rename></rename><length>-2</length><precision>-2</precision></field><field><name>valor</name><rename></rename><length>-2</length><precision>-2</precision></field><field><name>area_m2</name><rename></rename><length>-2</length><precision>-2</precision></field><field><name>fl_valor_invalido</name><rename></rename><length>-2</length><precision>-2</precision></field><field><name>fl_area_invalida</name><rename></rename><length>-2</length><precision>-2</precision></field><select_unspecified>N</select_unspecified></fields>
<attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps>
<GUI><xloc>1184</xloc><yloc>256</yloc><draw>Y</draw></GUI></step><step><name>dw.fato_patrimonio_anual</name><type>TableOutput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies>
<partitioning><method>none</method><schema_name/></partitioning>
